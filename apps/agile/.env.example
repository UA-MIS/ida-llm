# Copy to .env.local for local development. NEVER commit real values.
# In the cluster these come from Vault via External Secrets. Full reference: README.md

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://agile:agile@127.0.0.1:5432/agile
# >= 32 chars.  openssl rand -base64 48
SESSION_SECRET=
# Exact public origin; builds the OAuth callback URL.
APP_URL=http://localhost:3000

# ── Web sign-in: Dex OIDC (default) ─────────────────────────────────────────
OIDC_ISSUER=https://id.capstone.uamishub.com
OIDC_CLIENT_ID=ida-agile
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=<APP_URL>/api/auth/callback
# REQUIRED_GROUP=UA-MIS:ida-llm      # defaults to <GITHUB_ORG>:<GITHUB_TEAM>

# Fallback provider: direct GitHub OAuth (one OAuth app per instance).
# AUTH_PROVIDER=github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Identity: who this board is for (authorization = membership of this team) ──
GITHUB_ORG=UA-MIS
GITHUB_TEAM=ida-llm
GITHUB_REPOS=UA-MIS/ida-llm

# ── Branding ────────────────────────────────────────────────────────────────
BOARD_TITLE=IDA Agile
BOARD_ACCENT=#9e1b32

# ── Git integration (optional) ──────────────────────────────────────────────
# Set to enable webhooks; unset falls back to on-view + background polling.
GITHUB_WEBHOOK_SECRET=
# Credential for the unattended background poller (PAT or GitHub App token).
GITHUB_POLL_TOKEN=
# POLL_INTERVAL_SECONDS=300

# AUTO_BRANCH=true
# BRANCH_PATTERN={type}/{id}-{slug}
# AUTO_PROGRESS=true
# AUTO_PROGRESS_ON_COMMIT=true
# AUTO_PROGRESS_ON_PR_OPEN=true
# AUTO_PROGRESS_ON_PR_MERGE=true
# PR_BACKLINK_COMMENTS=true
# PR_COMMIT_STATUS=false

# ── Dependencies + trunk-based signals ──────────────────────────────────────
# ALLOW_DEPENDENCY_OVERRIDE=true
# STALE_BRANCH_DAYS=5
# STALE_BRANCH_BEHIND=20

# ── Attachments (optional; all four needed to enable) ───────────────────────
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_BUCKET=agile-attachments
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# ── Other ───────────────────────────────────────────────────────────────────
# AGILE_DB_SCHEMA=agile
# BOARD_INSTANCE=UA-MIS/ida-llm
