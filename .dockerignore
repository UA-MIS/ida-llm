# Keep the build context small AND deterministic. Kaniko hashes the context, so
# anything volatile in here invalidates the layer cache on every build.
.git
.github
.venv
venv
node_modules
**/node_modules
.next
**/.next
__pycache__
**/__pycache__
*.egg-info
**/*.egg-info
.pytest_cache
.ruff_cache
.env
.env.local
artifacts-local
docs
