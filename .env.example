# Copy to .env for local development: `cp .env.example .env`
#
# ⚠ .env IS GITIGNORED AND MUST STAY THAT WAY. Nothing in this file is a real
# value; every entry is a placeholder or a local-only default.
#
# In the CLUSTER none of this comes from a file. Non-secret values arrive from the
# ConfigMap (.devops/chart/base/configmap.yaml) and secret values from Vault via
# ESO (.devops/chart/overlays/<env>/app-secret.externalsecret.yaml). If you add a
# setting, add it in THREE places or it will work locally and be missing in the
# cluster: here, packages/core/src/ida_core/settings.py, and the ConfigMap or the
# ExternalSecret.

# ── process ─────────────────────────────────────────────────────────────────
# Required? no. Default: info. One of: debug, info, warning, error.
LOG_LEVEL=info
# Required? no. Default: 0.0.0.0. Bind address — leave as-is in containers; a
# loopback bind is invisible to kube-proxy and to the kubelet's probes.
HOST=0.0.0.0
# Required? no. Default: 8000. Each role sets its own in the chart.
PORT=8000

# ── datastores ──────────────────────────────────────────────────────────────
# Required? YES for api/runner/sweeps. Format: postgresql://user:pass@host:port/db
# In-cluster this is assembled by ESO from the Crossplane-provisioned parts at
# Vault tenants/ida-llm/<env>/database into the Secret `ida-llm-db`.
# Local default assumes `docker run postgres:17-alpine`.
DATABASE_URL=postgresql://ida:localdev@127.0.0.1:5432/ida_llm_dev

# Required? no. Default: redis://ida-llm-redis:6379/0 (the in-cluster Service).
REDIS_URL=redis://127.0.0.1:6379/0

# ── object store (MinIO) ────────────────────────────────────────────────────
# Required? no (host/port/bucket). In-cluster these come from the ConfigMap.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=run-artifacts
# Required? YES for anything that writes artifacts. In-cluster these are BOTH the
# client credentials AND the in-namespace MinIO's root credentials — one value,
# one source of truth, no drift.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── model providers ─────────────────────────────────────────────────────────
# THE SAFETY SWITCH. When set, the harness calls this endpoint instead of a paid
# provider. It is the DEFAULT in local dev, in CI and in PR previews — which is
# what makes "no pull request burns credits or reaches campus hardware" true by
# construction rather than by everyone remembering.
# Run it locally with: ida-mock-model
MOCK_MODEL_BASE_URL=http://127.0.0.1:8099
MOCK_MODEL_API_KEY=not-checked-by-the-mock

# Required? only when you deliberately select a cloud model. Format: the
# provider's key. LEAVE THESE EMPTY LOCALLY unless you mean to spend money.
# In-cluster they are per-environment, so a leaked dev key cannot be spent
# against the production budget.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── campus vLLM ("Sparks") ──────────────────────────────────────────────────
# Required? no — and it is NOT REACHABLE FROM THE CLUSTER TODAY, by decision.
# The tenant egress policy opens :443 to the internet but no route to Sparks
# (deferred; platform-infra/platform-services/ida-llm-egress/netpol.yaml carries
# the exact one-block change and the traps). Selecting the `sparks-local` model
# with this unset fails fast with a clear error instead of hanging.
SPARKS_BASE_URL=
SPARKS_API_KEY=

# ── mock model behaviour (local only) ───────────────────────────────────────
# Both are OFF by default. They exist so you can exercise the harness's retry
# and timeout paths without a real provider.
# MOCK_LATENCY_MS=25    # artificial latency per request, ms
# MOCK_FAIL_EVERY=5     # return 503 on every Nth request

# ── docker-compose host ports ───────────────────────────────────────────────
# These only affect what compose PUBLISHES to your machine. Services reach each
# other over the compose network on container ports, so changing one is safe.
# Set them if something already occupies a default (9000 is a common clash).
# API_PORT=8000
# FRONTEND_PORT=3000
# MOCK_MODEL_PORT=8100
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ── app-internal knobs (IDA_-prefixed, no ConfigMap entry) ──────────────────
# The seven platform-supplied names above are UNPREFIXED because that is what
# the ConfigMap and ESO write. These are ours, default correctly inside the
# image, and are only worth setting when you are debugging locally.
# IDA_ARTIFACT_BACKEND=s3      # or: local
# IDA_ARTIFACT_LOCAL_ROOT=.artifacts
# IDA_AUTH_MODE=none           # or: token
# IDA_RUNNER_POLL_TIMEOUT_S=5

# ── queue durability (see packages/core/ida_core/queue.py) ──────────────────
# The defaults are the deployed values: no ConfigMap entry, correct in-image.
# Worth touching only when reproducing a crash-recovery scenario locally.
# IDA_QUEUE_MAX_ATTEMPTS=3            # deliveries before a job is dead-lettered
# IDA_RUNNER_HEARTBEAT_INTERVAL_S=30  # must stay well below the TTL below, or a
#                                     # runner on a long job looks dead and its
#                                     # job gets recovered and run twice
# IDA_RUNNER_HEARTBEAT_TTL_S=90
# IDA_REAPER_INTERVAL_S=60            # how often each replica reconciles
# IDA_STALE_RUN_TTL_S=21600           # 6h: last-resort backstop for a run whose
#                                     # claim record is gone entirely. Erring
#                                     # SHORT would report a healthy long run as
#                                     # failed -- see the setting's docstring.
#                                     # ALSO read by the sweeps: how long a
#                                     # `queued` row counts as in-flight before
#                                     # its pair is assumed abandoned and
#                                     # re-planned. One horizon, two consumers.

# ── scheduled sweeps (see services/runner/ida_runner/sweeps.py) ─────────────
# The three CronJobs run a FIXED argv, so the environment is an operator's only
# lever in-cluster. Defaults are the deployed values: no ConfigMap entry.
# IDA_SWEEP_MAX_RUNS=200        # a sweep planning more runs than this REFUSES and
#                               # enqueues NOTHING, exiting non-zero. Refuse rather
#                               # than cap: a truncated suite reported as a whole
#                               # one is the false statement this platform exists
#                               # to avoid -- see enforce_budget's docstring.
# IDA_SWEEP_MAX_SAMPLES=2000    # the same guard in the unit that actually costs
#                               # money. One sample is one provider call, so a
#                               # run-count cap alone cannot bound spend.
# IDA_SWEEP_FORCE=0             # 1 re-enqueues pairs that are already measured,
#                               # bypassing dedupe. The budget caps still apply.
#                               # `ida-sweep <name> --force` does the same locally.
# IDA_SWEEP_JUDGE_CANDIDATE_LIMIT=500  # most ungraded subjective samples one
#                               # judge-calibration pass examines. The sweep logs
#                               # when it hits this, so a truncated pass never
#                               # reads as "that was all".

# ── LLM-as-judge (subjective tasks) ────────────────────────────────────────
# EMPTY = OFF, deliberately. A judge is one model call per rubric criterion per
# sample, so leaving this unset means subjective tasks run, archive their
# transcripts and record score=null -- rather than quietly spending money on
# every run because a feature merged. Set it to any key in models.yaml; the
# judge goes through the same client factory as the model under test.
# Grade an already-finished run later with:
#     python -m ida_harness.regrade <run_id>
# IDA_JUDGE_MODEL_KEY=mock

# ── mock-model judge behaviour (tests and local failure drills) ─────────────
# The mock endpoint answers the judge protocol deterministically. Flip it to
# `malformed` or `out_of_range` to prove the harness degrades a sample honestly
# instead of inventing a grade.
# MOCK_JUDGE_MODE=json         # or: malformed, out_of_range
