{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone-ida.dev/schemas/task.schema.json",
  "title": "A task definition (tasks/**/*.yaml)",
  "description": "Every task is exactly one of `verifiable` (programmatic scoring against a gold answer) or `subjective` (rubric + LLM judge). The taxonomy is enforced structurally by the allOf branches below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "kind",
    "scorer",
    "samples"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$",
      "description": "Globally unique, e.g. demo/arithmetic-quiz-check."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "verifiable",
        "subjective"
      ]
    },
    "domain": {
      "type": "string",
      "description": "Academic domain; used by the recommender (D-3)."
    },
    "system_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "scorer": {
      "$ref": "#/$defs/scorerSpec"
    },
    "rubric": {
      "$ref": "#/$defs/rubric"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verifiable"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "scorer": {
            "properties": {
              "kind": {
                "enum": [
                  "exact_match",
                  "numeric_match"
                ]
              }
            }
          },
          "samples": {
            "items": {
              "required": [
                "id",
                "input",
                "target"
              ]
            }
          }
        },
        "not": {
          "required": [
            "rubric"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "subjective"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "rubric"
        ],
        "properties": {
          "scorer": {
            "properties": {
              "kind": {
                "const": "llm_judge"
              }
            },
            "required": [
              "rubric_id"
            ]
          },
          "samples": {
            "items": {
              "not": {
                "required": [
                  "target"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "normalisation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit per-task, because silent normalisation is what makes numbers incomparable.",
      "properties": {
        "strip": {
          "type": "boolean"
        },
        "lowercase": {
          "type": "boolean"
        },
        "collapse_whitespace": {
          "type": "boolean"
        },
        "strip_punctuation": {
          "type": "boolean",
          "description": "Remove ASCII punctuation. NOT permitted with numeric_match -- it would destroy decimal points and thousands separators."
        },
        "take_last_line": {
          "type": "boolean"
        }
      }
    },
    "scorerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact_match",
            "numeric_match",
            "llm_judge"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "numeric_match: absolute tolerance."
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "numeric_match: relative tolerance."
        },
        "normalisation": {
          "$ref": "#/$defs/normalisation"
        },
        "rubric_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "llm_judge only; must equal rubric.id."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "numeric_match"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "normalisation": {
                "properties": {
                  "strip_punctuation": {
                    "const": false
                  }
                }
              }
            }
          },
          "$comment": "numeric_match forbids strip_punctuation: '.' and ',' are numerically significant, so stripping them turns '3.5' into '35' and scores correct answers as wrong. Mirrors the ScorerSpec validator in ida_core.contracts."
        }
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scale_min": {
          "type": "number"
        },
        "scale_max": {
          "type": "number"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "description": "Path-safe: it becomes the leaf of the transcript object key."
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Gold answer; verifiable tasks only."
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
